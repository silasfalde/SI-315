digraph case1_step2 {
    graph [layout=neato, overlap=false, splines=true, fontsize=13, margin=0.05];
    node [shape=rectangle, width=1.8, height=1.05, fixedsize=true, fontsize=24, margin=0.08];
    edge [arrowsize=0.6, color=darkgreen, penwidth=2.0];
    
    subgraph cluster_buyers {
        z [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ROWSPAN="2"><FONT POINT-SIZE="24">z</FONT></TD><TD><FONT POINT-SIZE="24">V: 2, 3, 0</FONT></TD></TR><TR><TD><FONT POINT-SIZE="24">P: 1, 1, 0</FONT></TD></TR></TABLE>>, pos="190,0!"];
        y [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ROWSPAN="2"><FONT POINT-SIZE="24">y</FONT></TD><TD><FONT POINT-SIZE="24">V: 1, 5, 3</FONT></TD></TR><TR><TD><FONT POINT-SIZE="24">P: 0, 3, 3</FONT></TD></TR></TABLE>>, pos="190,84!"];
        x [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ROWSPAN="2"><FONT POINT-SIZE="24">x</FONT></TD><TD><FONT POINT-SIZE="24">V: 2, 2, 1</FONT></TD></TR><TR><TD><FONT POINT-SIZE="24">P: 1, 0, 1</FONT></TD></TR></TABLE>>, pos="190,168!"];
        label="Buyers";
        labelloc=t;
        color=none;
    }
    
    subgraph cluster_sellers {
        C [label="C\np=0", pos="0,0!"];
        B [label="B\np=2", pos="0,84!"];
        A [label="A\np=1", pos="0,168!"];
        label="Sellers";
        labelloc=t;
        color=none;
    }
    
    x -> C;
    y -> B;
    z -> A;
}
