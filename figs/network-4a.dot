graph Network4A {
    graph [layout=neato, overlap=false, splines=true, outputorder=edgesfirst]
    node [shape=circle, style=filled, fillcolor=white]

    A -- x1 -- x2 -- x3 -- x4 -- A
    A -- x3
    x1 -- x3
    x2 -- x4
    x1 -- x4
    x2 -- x3

    B -- y1 -- y2 -- y3 -- y4 -- B
    B -- y3
    y1 -- y3
    y2 -- y4
    y1 -- y4
    y2 -- y3

    A -- B [penwidth=3, color=red]
}
