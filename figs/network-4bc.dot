graph Network4BC {
    graph [rankdir=LR, ranksep=1.0, nodesep=0.35, splines=true]
    node [shape=circle, style=filled, fillcolor=white]

    { rank=same; A }
    { rank=same; c1; c2 }
    { rank=same; d1; d2 }
    { rank=same; e1; e2 }
    { rank=same; f1; f2 }
    { rank=same; B }

    A -- c1
    A -- c2
    c1 -- c2

    c1 -- d1
    c1 -- d2
    c2 -- d1
    c2 -- d2

    d1 -- d2
    d1 -- e1
    d1 -- e2
    d2 -- e1
    d2 -- e2

    e1 -- e2
    e1 -- f1
    e1 -- f2
    e2 -- f1
    e2 -- f2

    f1 -- f2
    f1 -- B
    f2 -- B

    A -- B [penwidth=3, color=red, constraint=false]
}
